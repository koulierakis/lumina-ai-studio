# Core application
OWNER_EMAIL=owner@lumina.local
# Generate with:
# python -c "from auth import hash_password; print(hash_password(input()))"
OWNER_PASSWORD_HASH=
# Optional plaintext credential used only by live API integration tests.
LUMINA_TEST_OWNER_PASSWORD=
JWT_SECRET=
STORAGE_DIR=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2})(?::3000)?$
# Optional exact host allow-list. By default LUMINA allows localhost, 127.0.0.1, the computer name, and detected private LAN IP.
TRUSTED_HOSTS=

# Login protection
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900

# Image provider routing
IMAGE_PROVIDER=gemini
IMAGE_PROVIDER_FALLBACKS=gemini,openai,stable-diffusion
PROVIDER_RETRIES=2
PROVIDER_TIMEOUT_SECONDS=120

# Gemini
GEMINI_API_KEY=
GEMINI_API_KEY_ROTATION=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI Images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Stable Diffusion-compatible API
STABLE_DIFFUSION_URL=http://127.0.0.1:7860
STABLE_DIFFUSION_API_KEY=
STABLE_DIFFUSION_STEPS=24

# ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=

# Video Studio (the mock engine works locally without a paid provider)
VIDEO_PROVIDER=mock
# Voice Studio (local WAV mock provider; future adapters stay backend-only)
VOICE_PROVIDER=mock
# Planned real voice-cloning adapter: ElevenLabs (backend-only; not enabled by default)
ELEVENLABS_API_KEY=
ELEVENLABS_TIMEOUT_SECONDS=30
# Planned talking-face adapter: HeyGen (backend-only; not enabled by default)
TALKING_FACE_PROVIDER=mock
HEYGEN_API_KEY=
# Luma Dream Machine (optional; keep VIDEO_PROVIDER=mock until this is configured)
# Billing is charged by Luma to the account owning this key.
LUMA_API_KEY=
LUMA_API_BASE=https://api.lumalabs.ai/dream-machine/v1
LUMA_MODEL=ray-2
LUMA_TIMEOUT_SECONDS=30
VIDEO_PROVIDER_POLL_INTERVAL_SECONDS=5
VIDEO_PROVIDER_MAX_POLL_SECONDS=600
# Required only for Luma image-to-video. It must be a controlled HTTPS CDN prefix
# that exposes immutable uploaded source files by filename; do not use the private API URL.
LUMA_IMAGE_URL_BASE=

# Local AI (Ollama) / Code Creator
OLLAMA_URL=http://127.0.0.1:11434
CODE_MODEL=qwen2.5-coder:7b
LUMINA_VERSION=0.1.0
