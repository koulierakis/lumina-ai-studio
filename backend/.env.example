# Core application
OWNER_EMAIL=owner@lumina.local
# Generate with:
# python -c "from auth import hash_password; print(hash_password(input()))"
OWNER_PASSWORD_HASH=
# Optional plaintext credential used only by live API integration tests.
LUMINA_TEST_OWNER_PASSWORD=
JWT_SECRET=

# Runtime environment / source identity
LUMINA_ENV=development
GIT_COMMIT_SHA=

# Database (Supabase/PostgreSQL production example)
LUMINA_DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/postgres
# Optional alias when DATABASE_URL is not used
POSTGRES_DSN=

# User-file storage. Production/Render must use s3, r2, or supabase.
STORAGE_BACKEND=supabase
S3_BUCKET=YOUR_BUCKET_NAME
S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=YOUR_S3_REGION
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
# Local development only; ignored for cloud object storage.
STORAGE_DIR=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[0-1])(?:\.\d{1,3}){2})(?::3000)?$
# Optional exact host allow-list. By default LUMINA allows localhost, 127.0.0.1, the computer name, and detected private LAN IP.
TRUSTED_HOSTS=

# Login protection
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900

# Image provider routing
IMAGE_PROVIDER=gemini
IMAGE_PROVIDER_FALLBACKS=gemini,openai,stable-diffusion
PROVIDER_RETRIES=2
PROVIDER_TIMEOUT_SECONDS=120

# Gemini
GEMINI_API_KEY=
GEMINI_API_KEY_ROTATION=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# OpenAI Images
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Stable Diffusion-compatible API
STABLE_DIFFUSION_URL=http://127.0.0.1:7860
STABLE_DIFFUSION_API_KEY=
STABLE_DIFFUSION_STEPS=24

# ComfyUI
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=

# Video Studio (the mock engine works locally without a paid provider)
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_POLL_INTERVAL_SECONDS=5
VIDEO_PROVIDER_MAX_POLL_SECONDS=600

# Hugging Face Inference video (set VIDEO_PROVIDER=huggingface to enable)
HF_TOKEN=
HF_VIDEO_I2V_MODEL=Wan-AI/Wan2.2-I2V-A14B
HF_VIDEO_T2V_MODEL=Wan-AI/Wan2.1-T2V-1.3B
HF_VIDEO_TIMEOUT_SECONDS=600

# Luma Dream Machine (optional; set VIDEO_PROVIDER=luma to enable)
# Billing is charged by Luma to the account owning this key.
LUMA_API_KEY=
LUMA_API_BASE=https://api.lumalabs.ai/dream-machine/v1
LUMA_MODEL=ray-2
LUMA_TIMEOUT_SECONDS=30
# Required only for Luma image-to-video. It must be a controlled HTTPS CDN prefix
# that exposes immutable uploaded source files by filename; do not use the private API URL.
LUMA_IMAGE_URL_BASE=

# Voice Studio
VOICE_PROVIDER=edge-tts
# Personal Voice / OpenVoice V2 tone-color conversion.
# Remote mode: set OPENVOICE_V2_ENDPOINT to a compatible multipart endpoint.
OPENVOICE_V2_ENDPOINT=
OPENVOICE_V2_API_KEY=
OPENVOICE_V2_TIMEOUT_SECONDS=180
# Local Render mode: 1 = run OpenVoice V2 in-process on CPU.
OPENVOICE_V2_LOCAL=0
# 0 = keep Edge TTS as an explicitly marked fallback if conversion is unavailable.
# 1 = fail Personal Voice jobs instead of returning the Edge TTS fallback.
OPENVOICE_V2_REQUIRED=0
# Optional local cache location for downloaded source/checkpoints.
OPENVOICE_V2_CACHE_DIR=/tmp/lumina-openvoice-v2
# Planned optional adapters.
ELEVENLABS_API_KEY=
ELEVENLABS_TIMEOUT_SECONDS=30
# Planned talking-face adapter: HeyGen (backend-only; not enabled by default)
TALKING_FACE_PROVIDER=mock
HEYGEN_API_KEY=

# Local AI (Ollama) / Code Creator
OLLAMA_URL=http://127.0.0.1:11434
CODE_MODEL=qwen2.5-coder:7b
LUMINA_VERSION=0.1.0
# Groq cloud AI
GROQ_API_KEY=
LUMINA_GROQ_MODEL=openai/gpt-oss-120b

# Cloudflare Workers AI (Image Studio FLUX)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
