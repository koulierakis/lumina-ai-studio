{
 "requirements": [
  {
   "id": "REQ-001",
   "text": "Η εφαρμογή εμφανίζει φόρμα 'Νέος Πελάτης' με πεδία Ονοματεπώνυμο, Τηλέφωνο, Email και κουμπί 'Αποθήκευση'.",
   "kind": "ui",
   "verifiable": true
  },
  {
   "id": "REQ-002",
   "text": "Ο νέος πελάτης αποθηκεύεται και εμφανίζεται στη λίστα πελατών μετά από κλικ στο κουμπί 'Αποθήκευση'.",
   "kind": "behavior",
   "verifiable": true
  },
  {
   "id": "REQ-003",
   "text": "Τα δεδομένα αποθηκεύονται μόνιμα στον server (αρχείο JSON) και παραμένουν στη λίστα μετά από reload της σελίδας.",
   "kind": "data",
   "verifiable": true
  },
  {
   "id": "REQ-004",
   "text": "Υπάρχει πεδίο 'Αναζήτηση' που φιλτράρει τη λίστα πελατών κατά όνομα, τηλέφωνο ή email σε πραγματικό χρόνο — εμφανίζει μόνο αντίστοιχες εγγραφές και κρύβει τις υπόλοιπες.",
   "kind": "behavior",
   "verifiable": true
  },
  {
   "id": "REQ-005",
   "text": "Ολόκληρο το UI είναι στα ελληνικά (labels, placeholders, τίτλοι, κουμπιά).",
   "kind": "ui",
   "verifiable": true
  },
  {
   "id": "REQ-006",
   "text": "Η εφαρμογή είναι responsive και δεν παράγει οριζόντια overflow σε desktop (>=1024px) και mobile (<=480px) viewports.",
   "kind": "responsive",
   "verifiable": true
  }
 ],
