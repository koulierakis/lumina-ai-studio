+    def _save_to_disk(self) -> None:
+        try:
+            self._db_path.parent.mkdir(parents=True, exist_ok=True)
+
+            serializable_tasks = []
+            with self._lock:
+                for task in self._tasks.values():
+                    data = _serialize_value(task)
+                    if isinstance(data, dict):
+                        data.pop("execution_lock", None)
+                        data.pop("_save_callback", None)
+                        data["api_request"] = _serialize_value(task.api_request)
+                        data["request"] = _serialize_value(task.request)
+                    serializable_tasks.append(data)
+
+                with open(self._db_path, "w", encoding="utf-8") as f:
+                    json.dump(serializable_tasks, f, indent=2)
+        except Exception as exc:
+            logger.error("Failed to save TaskStore to disk: %s", exc)
+
+    def _load_from_disk(self) -> None:
+        try:
+            if not self._db_path.exists():
+                return
+            with open(self._db_path, "r", encoding="utf-8") as f:
+                data = json.load(f)
+
+            with self._lock:
+                for task_dict in data:
+                    # Note: Full reconstruction of nested models requires more parsing.
+                    # But this suffices for Phase 2: restart survivability.
+                    req = TaskRequest(**task_dict["request"])
+                    api_req = TaskCreateRequest(**task_dict["api_request"])
+                    task_dict["request"] = req
+                    task_dict["api_request"] = api_req
+                    task = StoredTask(**task_dict)
+                    task._save_callback = self._save_to_disk
+                    self._tasks[task.request.task_id] = task
+        except Exception as exc:
+            logger.error("Failed to load TaskStore from disk: %s", exc)
